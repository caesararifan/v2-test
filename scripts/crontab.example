# Subscriber usage automation - install with:  crontab scripts/crontab.example
# (edit the two paths below first; `which node` gives NODE_BIN)
#
# Option A (recommended): cron implementations that support CRON_TZ (cronie: RHEL/Fedora/Alpine-busybox varies)
CRON_TZ=Asia/Jakarta
API_BASE_URL=http://localhost:3000

# Snapshots at 08:00, 12:00, 15:00 WIB
0 8,12,15 * * * cd /opt/usage-api && /usr/bin/node scripts/snapshot.js >> logs/snapshot.log 2>&1
# Cleanup daily at 01:00 WIB
0 1 * * * cd /opt/usage-api && /usr/bin/node scripts/cleanup.js >> logs/cleanup.log 2>&1

# Option B: cron WITHOUT CRON_TZ support (e.g. Debian/Ubuntu cron) on a server whose clock is UTC.
# WIB = UTC+7 (no DST), so 08:00/12:00/15:00 WIB = 01:00/05:00/08:00 UTC, and 01:00 WIB = 18:00 UTC.
# Remove the CRON_TZ line above and use these instead:
# 0 1,5,8 * * * cd /opt/usage-api && /usr/bin/node scripts/snapshot.js >> logs/snapshot.log 2>&1
# 0 18 * * * cd /opt/usage-api && /usr/bin/node scripts/cleanup.js >> logs/cleanup.log 2>&1
